{
  "name": "mybookshop",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.1.2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.12.2",
    "express": "^4",
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/resilience": "^3"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "chai-subset": "^1.6.0",
    "jest": "^30.2.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-bookshop_ui": "cds watch --open bookshopui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy mybookshop --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "db": "sqlite",
        "auth": {
          "kind": "mocked",
          "users": {
            "admin@example.com": {
              "password": "initial",
              "ID": "admin@example.com",
              "roles": [
                "Admin"
              ],
              "attr": {
                "country": "UK"
              }
            },
            "user1@example.com": {
              "password": "initial",
              "ID": "user1@example.com",
              "roles": [
                "authenticated-user"
              ],
              "attr": {
                "country": "UK"
              }
            }
          }
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "credentials": {
          "destination": "S4_sandbox",
          "path": "/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER"
        }
      },
      "application-logging": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/bookshop_ui"
  ]
}
